{
  "manifest_version": 3,
  "name": "OutboundXray",
  "version": "1.3.0",
  "description": "An X-ray of what leaves your browser: see, in plain language, what the page you're on sends about you, and to whom.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "sidePanel", "storage", "webRequest", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "OutboundXray: see what this page sends",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
